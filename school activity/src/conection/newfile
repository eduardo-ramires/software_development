CREATE TABLE matricula(
	id int auto_increment PRIMARY KEY,
    id_escola int,
    id_profesor int,
    data_matricula date,
    FOREIGN KEY (id_escola) REFERENCES escola(id),
    FOREIGN KEY (id_profesor) REFERENCES profesores(id)
);


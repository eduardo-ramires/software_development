CREATE TABLE matricula(
	id int auto_increment PRIMARY KEY,
    id_aluno int,
    id_profesor int,
    data_matricula date,
    FOREIGN KEY (id_aluno) REFERENCES aluno(id),
    FOREIGN KEY (id_profesor) REFERENCES profesores(id)
);

